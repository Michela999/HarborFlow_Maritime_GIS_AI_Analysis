import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path)  # Strip whitespace from column names (removes hidden characters) df_weather.columns = df_weather.columns.str.strip()  # ----------------------------- # 3️⃣ Merge weather data by vessel # ----------------------------- df = df.merge(     df_weather[['shipname', 'avg_wind_speed', 'avg_precipitation']],      on='shipname', how='left' )  # ----------------------------- # 4️⃣ Normalize weather features # ----------------------------- df['wind_norm'] = df['avg_wind_speed'] / df['avg_wind_speed'].max() df['precip_norm'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # Weather risk score: 50% wind + 50% precipitation df['weather_risk_score'] = 0.5 * df['wind_norm'] + 0.5 * df['precip_norm']  # ----------------------------- # 5️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # Categorize final operational risk def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 6️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully!") print("Saved final multi-factor dataset to:", final_path)  # ----------------------------- # 7️⃣ Quick validation # ----------------------------- print("\nColumns in dataset:") print(df.columns.tolist())  print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
