import arcpy import pandas as pd import os  # ---------------------------- # CONFIGURATION # ----------------------------  # Folder paths csv_folder = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed" gdb_name = "HarborFlow.gdb" gdb_path = os.path.join(csv_folder, gdb_name)  # Create geodatabase if it doesn't exist if not arcpy.Exists(gdb_path):     arcpy.management.CreateFileGDB(csv_folder, gdb_name)     print("Created geodatabase:", gdb_path)  # CSV exports and desired output feature class names tables = {     "ais_traffic_export.csv": "ais_points",     "maintenance_gaps_export.csv": "maintenance_points",     "weather_speed_export.csv": "weather_points" }  # ---------------------------- # PROCESS EACH TABLE # ----------------------------  for csv_file, fc_name in tables.items():     csv_path = os.path.join(csv_folder, csv_file)     output_fc = os.path.join(gdb_path, fc_name)          print(f"\nProcessing {csv_file} → {fc_name}")          # Check if CSV exists     if not os.path.exists(csv_path):         print(f"ERROR: File not found: {csv_path}")         continue          # Load CSV     df = pd.read_csv(csv_path, encoding='utf-8-sig')          # Drop rows with missing coordinates     df = df.dropna(subset=["latitude", "longitude"])          # Ensure numeric lat/lon     df["latitude"] = pd.to_numeric(df["latitude"], errors='coerce')     df["longitude"] = pd.to_numeric(df["longitude"], errors='coerce')     df = df.dropna(subset=["latitude", "longitude"])          # Add OBJECTID if missing     if "objectid" not in df.columns:         df["objectid"] = range(1, len(df)+1)          # Save cleaned CSV     df.to_csv(csv_path, index=False)          # Convert to XY points in ArcGIS     arcpy.management.XYTableToPoint(         in_table=csv_path,         out_feature_class=output_fc,         x_field="longitude",         y_field="latitude",         z_field=None,         coordinate_system=arcpy.SpatialReference(4326)  # WGS84     )          print(f"Point layer created: {output_fc}")  print("\n✅ All export CSVs processed into GIS point layers!")
import arcpy import pandas as pd import os  # ---------------------------- # CONFIGURATION # ----------------------------  # Folder paths csv_folder = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed" gdb_name = "HarborFlow.gdb" gdb_path = os.path.join(csv_folder, gdb_name)  # Create geodatabase if it doesn't exist if not arcpy.Exists(gdb_path):     arcpy.management.CreateFileGDB(csv_folder, gdb_name)     print("Created geodatabase:", gdb_path)  # CSV exports and output feature class names tables = {     "ais_traffic_export.csv": "ais_points",     "ais_avg_speed_export.csv": "ais_speed_points",     "maintenance_gaps_export.csv": "maintenance_points",     "weather_speed_export.csv": "weather_points" }  # ---------------------------- # PROCESS EACH CSV # ----------------------------  ml_dfs = []  # List to store dataframes for ML integration  for csv_file, fc_name in tables.items():     csv_path = os.path.join(csv_folder, csv_file)     output_fc = os.path.join(gdb_path, fc_name)          print(f"\nProcessing {csv_file} → {fc_name}")          if not os.path.exists(csv_path):         print(f"ERROR: File not found: {csv_path}")         continue          # Load CSV     df = pd.read_csv(csv_path, encoding='utf-8-sig')          # Drop rows with missing coordinates     if 'latitude' in df.columns and 'longitude' in df.columns:         df = df.dropna(subset=['latitude', 'longitude'])         df['latitude'] = pd.to_numeric(df['latitude'], errors='coerce')         df['longitude'] = pd.to_numeric(df['longitude'], errors='coerce')         df = df.dropna(subset=['latitude', 'longitude'])                  # Add OBJECTID if missing         if 'objectid' not in df.columns:             df['objectid'] = range(1, len(df)+1)                  # Save cleaned CSV back         df.to_csv(csv_path, index=False)                  # Convert CSV to XY points         arcpy.management.XYTableToPoint(             in_table=csv_path,             out_feature_class=output_fc,             x_field="longitude",             y_field="latitude",             z_field=None,             coordinate_system=arcpy.SpatialReference(4326)         )         print(f"Point layer created: {output_fc}")          # Store dataframe for ML integration     ml_dfs.append(df)  # ---------------------------- # MERGE CSVs INTO ONE ML-READY DATASET # ----------------------------  # Example: merge on 'port_id' and 'timestamp' # Adjust keys depending on your CSV structure ml_dataset = ml_dfs[0]  # start with first df  for df in ml_dfs[1:]:     merge_keys = ['port_id', 'timestamp']  # adjust if needed     common_keys = [k for k in merge_keys if k in df.columns and k in ml_dataset.columns]     if common_keys:         ml_dataset = ml_dataset.merge(df, how='left', on=common_keys)     else:         print(f"WARNING: Could not merge {df} – keys not found")  # Save ML-ready dataset ml_dataset.to_csv(os.path.join(csv_folder, 'ml_ready_dataset.csv'), index=False) print("\n✅ ML-ready dataset created: ml_ready_dataset.csv")
import arcpy import os  # --------------------------------- # Paths # ---------------------------------  project_folder = r"C:\Users\miche\Documents\HarborFlow_Fresh"  ais_shapefile = os.path.join(project_folder, "data", "processed", "AIS_points.shp") predictions_csv = os.path.join(project_folder, "data", "processed", "ml_predictions.csv")  output_folder = os.path.join(project_folder, "data", "processed") output_shapefile = os.path.join(output_folder, "AIS_points_predicted.shp")  arcpy.env.workspace = output_folder arcpy.env.overwriteOutput = True  print("Starting ArcPy join process...")  # --------------------------------- # Convert CSV to table # ---------------------------------  csv_table = "predictions_table"  arcpy.conversion.TableToTable(     predictions_csv,     output_folder,     csv_table )  print("CSV converted to table.")  # --------------------------------- # Copy AIS shapefile # ---------------------------------  arcpy.management.CopyFeatures(     ais_shapefile,     output_shapefile )  print("AIS shapefile copied.")  # --------------------------------- # Join predictions # ---------------------------------  arcpy.management.JoinField(     in_data=output_shapefile,     in_field="shipname",     join_table=os.path.join(output_folder, csv_table),     join_field="shipname" )  print("Join completed successfully.") print("New shapefile created:") print(output_shapefile)
import arcpy import os  project_folder = r"C:\Users\miche\Documents\HarborFlow_Fresh"  output_folder = os.path.join(project_folder, "data", "processed") output_shapefile = os.path.join(output_folder, "AIS_points_predicted.shp") predictions_table = os.path.join(output_folder, "predictions_table")  arcpy.env.workspace = output_folder arcpy.env.overwriteOutput = True  arcpy.management.JoinField(     in_data=output_shapefile,     in_field="ShipName",          # <-- corrected     join_table=predictions_table,     join_field="shipname" )  print("✅ Join corrected successfully.")
import arcpy import os import pandas as pd  # ----------------------------- # Paths # ----------------------------- project_folder = r"C:\Users\miche\Documents\HarborFlow_Fresh"  # Input shapefile and CSV ais_shapefile = os.path.join(project_folder, "data", "processed", "AIS_points.shp") predictions_csv = os.path.join(project_folder, "data", "processed", "ml_predictions.csv")  # Output shapefile output_folder = os.path.join(project_folder, "data", "processed") output_shapefile = os.path.join(output_folder, "AIS_points_predicted_fixed.shp")  arcpy.env.workspace = output_folder arcpy.env.overwriteOutput = True  print("Starting ArcPy join process...")  # ----------------------------- # Step 1: Copy shapefile # ----------------------------- arcpy.management.CopyFeatures(ais_shapefile, output_shapefile) print("✅ Shapefile copied.")  # ----------------------------- # Step 2: Read CSV and check keys # ----------------------------- df_csv = pd.read_csv(predictions_csv) print("CSV columns:", df_csv.columns) print("CSV shipname sample:", df_csv['shipname'].head())  # ----------------------------- # Step 3: Add a new text key to shapefile if needed # ----------------------------- # We'll assume shapefile ShipName is numeric and CSV shipname is string # Create new field to match CSV key_field = "join_shipname"  if key_field not in [f.name for f in arcpy.ListFields(output_shapefile)]:     arcpy.AddField_management(output_shapefile, key_field, "TEXT", field_length=50)     print(f"✅ Added new field '{key_field}' to shapefile.")  # ----------------------------- # Step 4: Map numeric ShipName to CSV shipname # ----------------------------- # Example: create a mapping dict # You must adjust this mapping to match your real IDs # For demonstration, let's assume: # numeric 1 -> V001, 2 -> V002, etc.  mapping_dict = {     1: "V001",     2: "V002",     3: "V003",     4: "V004",     5: "V005" }  # Calculate field using mapping with arcpy.da.UpdateCursor(output_shapefile, ["ShipName", key_field]) as cursor:     for row in cursor:         num_val = row[0]         if num_val in mapping_dict:             row[1] = mapping_dict[num_val]         else:             row[1] = None         cursor.updateRow(row)  print(f"✅ Field '{key_field}' populated with CSV-compatible keys.")  # ----------------------------- # Step 5: Convert CSV to table # ----------------------------- csv_table = "predictions_table" arcpy.conversion.TableToTable(predictions_csv, output_folder, csv_table) print("✅ CSV converted to table.")  # ----------------------------- # Step 6: Join predictions # ----------------------------- arcpy.management.JoinField(     in_data=output_shapefile,     in_field=key_field,              # new shapefile field     join_table=os.path.join(output_folder, csv_table),     join_field="shipname"            # CSV field )  print("✅ Join completed successfully!") print("New shapefile created:", output_shapefile)
import arcpy import os  # ------------------------------------------------- # CONFIGURATION # -------------------------------------------------  project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh"  arcpy.env.workspace = project_root arcpy.env.overwriteOutput = True  shapefile = os.path.join(project_root, "data", "processed", "AIS_points.shp") csv_file = os.path.join(project_root, "data", "processed", "ml_predictions.csv") output_shp = os.path.join(project_root, "maps", "AIS_points_predicted.shp")  clean_field = "JOIN_KEY"  print("Workspace set to:", project_root)  # ------------------------------------------------- # STEP 1 – STANDARDIZE SHAPEFILE JOIN KEY # -------------------------------------------------  existing_fields = [f.name for f in arcpy.ListFields(shapefile)]  if clean_field not in existing_fields:     arcpy.AddField_management(shapefile, clean_field, "TEXT", field_length=100)  with arcpy.da.UpdateCursor(shapefile, ["ShipName", clean_field]) as cursor:     for row in cursor:         if row[0]:             row[1] = row[0].strip().upper()         cursor.updateRow(row)  print("Shapefile join key standardized.")  # ------------------------------------------------- # STEP 2 – STANDARDIZE CSV JOIN KEY # -------------------------------------------------  csv_table = "in_memory\\pred_table" arcpy.TableToTable_conversion(csv_file, "in_memory", "pred_table")  existing_fields_csv = [f.name for f in arcpy.ListFields(csv_table)]  if clean_field not in existing_fields_csv:     arcpy.AddField_management(csv_table, clean_field, "TEXT", field_length=100)  with arcpy.da.UpdateCursor(csv_table, ["shipname", clean_field]) as cursor:     for row in cursor:         if row[0]:             row[1] = row[0].strip().upper()         cursor.updateRow(row)  print("CSV join key standardized.")  # ------------------------------------------------- # STEP 3 – VALIDATE COUNTS BEFORE JOIN # -------------------------------------------------  print("AIS feature count:",       arcpy.GetCount_management(shapefile)[0])  print("Prediction table count:",       arcpy.GetCount_management(csv_table)[0])  # ------------------------------------------------- # STEP 4 – PERFORM JOIN # -------------------------------------------------  arcpy.AddJoin_management(     shapefile,     clean_field,     csv_table,     clean_field,     "KEEP_COMMON" )  print("Join executed.")  # ------------------------------------------------- # STEP 5 – EXPORT RESULT # -------------------------------------------------  arcpy.CopyFeatures_management(shapefile, output_shp)  print("Output shapefile created at:") print(output_shp)  # ------------------------------------------------- # STEP 6 – VALIDATE JOIN SUCCESS # -------------------------------------------------  joined_count = arcpy.GetCount_management(output_shp)[0] print("Joined feature count:", joined_count)  print("Fields in output:") for f in arcpy.ListFields(output_shp):     print(f.name)  print("Process completed successfully.")
with arcpy.da.UpdateCursor(shapefile, ["ShipName", clean_field]) as cursor:     for row in cursor:         if row[0] is not None:             row[1] = str(row[0]).strip().upper()         else:             row[1] = None         cursor.updateRow(row)
