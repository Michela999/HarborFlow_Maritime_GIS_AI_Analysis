import pandas as pd import arcpy  # ============================= # 1️⃣ Load ML Features Dataset # ============================= file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" df = pd.read_csv(file_path)  # Recompute traffic intensity (safe) df['traffic_intensity'] = df['visits'] / df['visits'].sum()  # Dynamically set high traffic flag (top 25%) threshold = df['traffic_intensity'].quantile(0.75) df['high_traffic_flag'] = (df['traffic_intensity'] > threshold).astype(int)  # Ensure predicted_high_traffic exists df['predicted_high_traffic'] = df['high_traffic_flag']  # Save updated CSV df.to_csv(file_path, index=False) print("✅ ML features dataset updated with high traffic flags.") print(df['high_traffic_flag'].value_counts())  # ============================= # 2️⃣ Update ArcGIS Feature Class # ============================= gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" features_fc = gdb + r"\AIS_points_predicted"  # Add JOIN_KEY field if it doesn't exist if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(features_fc)]:     arcpy.management.AddField(features_fc, "JOIN_KEY", "TEXT", field_length=100)  # Populate JOIN_KEY in ArcGIS if needed (example: use shipname) # arcpy.management.CalculateField(features_fc, "JOIN_KEY", "!shipname!", "PYTHON3")    # Join CSV predictions to GIS layer arcpy.management.JoinField(features_fc, "JOIN_KEY", file_path, "shipname", ["predicted_high_traffic"]) print("✅ ArcGIS feature class updated with predicted_high_traffic.")  # ============================= # 3️⃣ Compute High/Low Traffic Distribution # ============================= with arcpy.da.SearchCursor(features_fc, ["predicted_high_traffic"]) as cursor:     values = [row[0] for row in cursor]  high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100 print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
import pandas as pd import arcpy  # Load CSV csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" df = pd.read_csv(csv_path)  # Ensure shipname column is string and trimmed df['shipname'] = df['shipname'].astype(str).str.strip()  # Update ArcGIS layer gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  # Add JOIN_KEY if missing if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.AddField(fc, "JOIN_KEY", "TEXT", field_length=100)  # Populate JOIN_KEY in ArcGIS using shipname (Python expression) arcpy.management.CalculateField(fc, "JOIN_KEY", "!shipname!", "PYTHON3")  # Save CSV with matching column name df.to_csv(csv_path, index=False)
