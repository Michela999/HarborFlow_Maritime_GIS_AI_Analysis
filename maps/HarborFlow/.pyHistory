import arcpy import pandas as pd import os  # ---------------------------- # CONFIGURATION # ----------------------------  # Folder paths csv_folder = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed" gdb_path = os.path.join(csv_folder, "HarborFlow.gdb")  # Create geodatabase if it doesn't exist if not arcpy.Exists(gdb_path):     arcpy.management.CreateFileGDB(csv_folder, "HarborFlow.gdb")     print("Created geodatabase:", gdb_path)  # List of CSV files and output layer names tables = {     "ais_data.csv": "ais_points",     "maintenance_data.csv": "maintenance_points",     "weather_data.csv": "weather_points" }  # ---------------------------- # PROCESS EACH TABLE # ----------------------------  for csv_name, fc_name in tables.items():     csv_path = os.path.join(csv_folder, csv_name)     output_fc = os.path.join(gdb_path, fc_name)      print(f"\nProcessing {csv_name} → {fc_name}")      # Read CSV with Pandas     df = pd.read_csv(csv_path)      # Drop rows with missing coordinates     df = df.dropna(subset=["latitude", "longitude"])      # Ensure numeric lat/lon     df["latitude"] = pd.to_numeric(df["latitude"], errors='coerce')     df["longitude"] = pd.to_numeric(df["longitude"], errors='coerce')     df = df.dropna(subset=["latitude", "longitude"])      # Add objectid if missing     if "objectid" not in df.columns:         df["objectid"] = range(1, len(df) + 1)      # Save cleaned CSV     df.to_csv(csv_path, index=False)      # Convert to XY points in ArcGIS     arcpy.management.XYTableToPoint(         in_table=csv_path,         out_feature_class=output_fc,         x_field="longitude",         y_field="latitude",         z_field=None,         coordinate_system=arcpy.SpatialReference(4326)  # WGS84     )      print(f"Layer created: {output_fc}")  print("\n✅ All layers processed successfully!")
