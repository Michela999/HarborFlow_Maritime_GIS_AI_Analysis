import pandas as pd  # Path to your features dataset file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv"  # Load dataset df = pd.read_csv(file_path)  # Compute traffic intensity df['traffic_intensity'] = df['visits'] / df['visits'].sum()  # Dynamically set threshold (top 25% traffic points) threshold = df['traffic_intensity'].quantile(0.75) df['high_traffic_flag'] = (df['traffic_intensity'] > threshold).astype(int)  # Optional: normalize speed and compute weather impact (if not done yet) df['speed_normalized'] = df['avg_speed_knots'] / df['avg_speed_knots'].max() df['weather_impact'] = df['avg_wind_speed'] * df['avg_precipitation']  # Save back to the same CSV df.to_csv(file_path, index=False)  # Quick check print(df['high_traffic_flag'].value_counts()) print("ML features dataset updated with high traffic flags.")
