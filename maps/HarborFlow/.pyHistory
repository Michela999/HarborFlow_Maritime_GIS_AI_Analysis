import arcpy import os  # ----------------------------- # PATHS # -----------------------------  workspace = r"C:\YourProject\HarborFlow" arcpy.env.workspace = workspace arcpy.env.overwriteOutput = True  shapefile = os.path.join(workspace, "data", "processed", "AIS_points.shp") csv_file = os.path.join(workspace, "data", "processed", "ml_predictions.csv") output_shp = os.path.join(workspace, "maps", "AIS_points_predicted.shp")  # ----------------------------- # STEP 1 – Create Clean Join Field in Shapefile # -----------------------------  clean_field = "JOIN_KEY"  # Add field if not exists if clean_field not in [f.name for f in arcpy.ListFields(shapefile)]:     arcpy.AddField_management(shapefile, clean_field, "TEXT", field_length=100)  # Normalize ShipName (UPPER + strip) with arcpy.da.UpdateCursor(shapefile, ["ShipName", clean_field]) as cursor:     for row in cursor:         if row[0]:             row[1] = row[0].strip().upper()         cursor.updateRow(row)  print("Shapefile join key standardized.")  # ----------------------------- # STEP 2 – Create Clean Join Field in CSV # -----------------------------  # Convert CSV to table in memory csv_table = "in_memory\\pred_table" arcpy.TableToTable_conversion(csv_file, "in_memory", "pred_table")  if clean_field not in [f.name for f in arcpy.ListFields(csv_table)]:     arcpy.AddField_management(csv_table, clean_field, "TEXT", field_length=100)  with arcpy.da.UpdateCursor(csv_table, ["shipname", clean_field]) as cursor:     for row in cursor:         if row[0]:             row[1] = row[0].strip().upper()         cursor.updateRow(row)  print("CSV join key standardized.")  # ----------------------------- # STEP 3 – Perform Join # -----------------------------  arcpy.AddJoin_management(     shapefile,     clean_field,     csv_table,     clean_field,     "KEEP_COMMON" )  print("Join executed.")  # ----------------------------- # STEP 4 – Export Joined Result # -----------------------------  arcpy.CopyFeatures_management(shapefile, output_shp)  print("Output shapefile created:", output_shp)  # ----------------------------- # STEP 5 – Validate Join Success # -----------------------------  fields = [f.name for f in arcpy.ListFields(output_shp)] print("Output fields:", fields)  print("Process complete.")
