import arcpy  aprx = arcpy.mp.ArcGISProject("CURRENT") lyt = aprx.listLayouts()[0]   # Change if needed legend = lyt.listElements("LEGEND_ELEMENT")[0]  # Get CIM definition cim = legend.getDefinition("V3")  # Increase title font size if cim.titleSymbol:     cim.titleSymbol.symbol.size = 20  # Legend title size  # Increase legend item label font size for item in cim.items:     if item.labelSymbol:         item.labelSymbol.symbol.size = 16  # Low / High Traffic size  # Apply changes legend.setDefinition(cim) aprx.save()  print("✅ Legend font size updated using CIM")
