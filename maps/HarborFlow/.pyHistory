import pandas as pd import arcpy  # Paths csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  # Load CSV and normalize shipname df = pd.read_csv(csv_path) df['shipname_norm'] = df['shipname'].astype(str).str.strip().str.lower() df['predicted_high_traffic'] = df['high_traffic_flag']  # Save normalized CSV for join df[['shipname_norm','predicted_high_traffic']].to_csv(csv_path, index=False)  # Add JOIN_KEY if missing if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.AddField(fc, "JOIN_KEY", "TEXT", field_length=100)  # Populate JOIN_KEY in ArcGIS safely (handle NULLs) expression = "(!shipname! if !shipname! else '').strip().lower()" arcpy.management.CalculateField(fc, "JOIN_KEY", expression, "PYTHON3")  # Perform join using normalized keys arcpy.management.JoinField(fc, "JOIN_KEY", csv_path, "shipname_norm", ["predicted_high_traffic"])  # Check distribution with arcpy.da.SearchCursor(fc, ["predicted_high_traffic"]) as cursor:     values = [row[0] for row in cursor]  high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100 print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
import pandas as pd import arcpy  # Paths csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  # 1️⃣ Load CSV and clean shipname df = pd.read_csv(csv_path)  # Normalize shipname safely df['shipname_norm'] = df['shipname'].astype(str).fillna('').str.strip().str.lower() df['predicted_high_traffic'] = df['high_traffic_flag']  # Save only necessary columns for join df[['shipname_norm','predicted_high_traffic']].to_csv(csv_path, index=False)  # 2️⃣ Create JOIN_KEY in ArcGIS (simple, just copy shipname field) if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.AddField(fc, "JOIN_KEY", "TEXT", field_length=100)  # Use arcpy.da.UpdateCursor to populate JOIN_KEY safely with arcpy.da.UpdateCursor(fc, ["shipname", "JOIN_KEY"]) as cursor:     for row in cursor:         ship = row[0]         row[1] = str(ship).strip().lower() if ship else ''         cursor.updateRow(row)  # 3️⃣ Join CSV using normalized key arcpy.management.JoinField(fc, "JOIN_KEY", csv_path, "shipname_norm", ["predicted_high_traffic"])  # 4️⃣ Compute distribution with arcpy.da.SearchCursor(fc, ["predicted_high_traffic"]) as cursor:     values = [row[0] for row in cursor]  high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100 print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
import pandas as pd  csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv"  # Load CSV df = pd.read_csv(csv_path)  # Drop rows where shipname is null or empty df = df[df['shipname'].notna() & (df['shipname'].str.strip() != '')]  # Normalize shipname for join df['shipname_norm'] = df['shipname'].str.strip().str.lower()  # Ensure predicted_high_traffic exists df['predicted_high_traffic'] = df['high_traffic_flag']  # Save cleaned CSV df[['shipname_norm', 'predicted_high_traffic']].to_csv(csv_path, index=False) print("✅ CSV cleaned and ready for ArcGIS join")
