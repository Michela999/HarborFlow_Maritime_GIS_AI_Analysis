import arcpy import os  # ----------------------------- # Project paths # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") layer_fc = os.path.join(gdb, "AIS_points_predicted") output_png = os.path.join(project_root, "docs", "screens", "phase4", "AIS_HighTraffic_Map.png")  # ----------------------------- # Access ArcGIS Pro Project # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT")  # Access renamed layout lyt = aprx.listLayouts("Phase4_Layout")[0]  # Access map frame map_frame = lyt.listElements("MAPFRAME_ELEMENT")[0]  # ----------------------------- # Zoom to predicted layer # ----------------------------- desc = arcpy.Describe(layer_fc) map_frame.camera.setExtent(desc.extent)  # Optional: Slight zoom buffer (uncomment if needed) # map_frame.camera.scale *= 1.1  # ----------------------------- # Export Layout # ----------------------------- lyt.exportToPNG(output_png, resolution=300)  print("✅ Phase 4 portfolio map exported successfully!") print("Saved to:", output_png)
import arcpy import os  project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") layer_fc = os.path.join(gdb, "AIS_points_predicted")  aprx = arcpy.mp.ArcGISProject("CURRENT") lyt = aprx.listLayouts("Phase4_Layout")[0] map_frame = lyt.listElements("MAPFRAME_ELEMENT")[0]  desc = arcpy.Describe(layer_fc) extent = desc.extent  # Add 10% buffer x_buffer = (extent.XMax - extent.XMin) * 0.1 y_buffer = (extent.YMax - extent.YMin) * 0.1  buffered_extent = arcpy.Extent(     extent.XMin - x_buffer,     extent.YMin - y_buffer,     extent.XMax + x_buffer,     extent.YMax + y_buffer )  map_frame.camera.setExtent(buffered_extent)  print("✅ Map zoomed with buffer")
