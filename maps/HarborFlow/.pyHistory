import pandas as pd  # ----------------------------- # Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # Load weather dataset WITHOUT relying on headers # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" # Read normally df_weather = pd.read_csv(weather_path, encoding='utf-8-sig')  # Force renaming by column position to safe names # Indexes: 0=shipname, 1=avg_speed_knots, 2=avg_wind_speed, 3=avg_precipitation df_weather.columns = ['shipname','avg_speed_knots','avg_wind_speed','avg_precipitation']  print("Renamed weather columns:", df_weather.columns.tolist())  # ----------------------------- # Merge by shipname # ----------------------------- df = df.merge(df_weather[['shipname','avg_precipitation']], on='shipname', how='left')  # ----------------------------- # Compute weather risk (precipitation only) # ----------------------------- df['weather_risk_score'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # ----------------------------- # Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # Risk categories def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully (precipitation-only)!") print("Saved to:", final_path)  # Quick check print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts()) print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset WITHOUT relying on header names # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, encoding='utf-8-sig')  # ----------------------------- # 3️⃣ Access avg_precipitation by index (last column) # ----------------------------- # Assuming columns: 0=shipname, 1=avg_speed_knots, 2=avg_wind_speed, 3=avg_precipitation df_weather = df_weather[[df_weather.columns[0], df_weather.columns[3]]]  # shipname + precipitation df_weather.columns = ['shipname','avg_precipitation']  # ----------------------------- # 4️⃣ Merge by shipname # ----------------------------- df = df.merge(df_weather, on='shipname', how='left')  # ----------------------------- # 5️⃣ Compute weather risk (precipitation only) # ----------------------------- df['weather_risk_score'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # ----------------------------- # 6️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 7️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully (precipitation-only, index-based)!") print("Saved to:", final_path)  # ----------------------------- # 8️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts()) print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset WITHOUT using headers # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, header=None, encoding='utf-8-sig')  # ----------------------------- # 3️⃣ Assign safe column names manually # ----------------------------- # ArcGIS CSV columns (by inspection): # 0 = shipname, 1 = avg_speed_knots, 2 = avg_wind_speed, 3 = avg_precipitation df_weather.columns = ['shipname','avg_speed_knots','avg_wind_speed','avg_precipitation']  print("Safe weather columns:", df_weather.columns.tolist())  # ----------------------------- # 4️⃣ Merge by shipname # ----------------------------- df = df.merge(df_weather[['shipname','avg_precipitation']], on='shipname', how='left')  # ----------------------------- # 5️⃣ Compute weather risk (precipitation only) # ----------------------------- df['weather_risk_score'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # ----------------------------- # 6️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # ----------------------------- # 7️⃣ Categorize risk # ----------------------------- def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 8️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully (precipitation-only, header ignored)!") print("Saved to:", final_path)  # ----------------------------- # 9️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset WITHOUT using headers # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, header=None, encoding='utf-8-sig')  # ----------------------------- # 3️⃣ Assign safe column names manually # ----------------------------- df_weather.columns = ['shipname','avg_speed_knots','avg_wind_speed','avg_precipitation'] print("Safe weather columns:", df_weather.columns.tolist())  # ----------------------------- # 4️⃣ Convert shipname columns to string # ----------------------------- df['shipname'] = df['shipname'].astype(str) df_weather['shipname'] = df_weather['shipname'].astype(str)  # ----------------------------- # 5️⃣ Merge by shipname # ----------------------------- df = df.merge(df_weather[['shipname','avg_precipitation']], on='shipname', how='left')  # ----------------------------- # 6️⃣ Compute weather risk (precipitation only) # ----------------------------- df['weather_risk_score'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # ----------------------------- # 7️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # ----------------------------- # 8️⃣ Categorize risk # ----------------------------- def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 9️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully (precipitation-only, type-safe)!") print("Saved to:", final_path)  # ----------------------------- # 10️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset WITHOUT relying on header # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, header=None, encoding='utf-8-sig')  # ----------------------------- # 3️⃣ Assign safe column names # ----------------------------- df_weather.columns = ['shipname','avg_speed_knots','avg_wind_speed','avg_precipitation_safe']  print("Safe weather columns:", df_weather.columns.tolist())  # ----------------------------- # 4️⃣ Convert shipname to string in both datasets # ----------------------------- df['shipname'] = df['shipname'].astype(str) df_weather['shipname'] = df_weather['shipname'].astype(str)  # ----------------------------- # 5️⃣ Merge by shipname # ----------------------------- # Use the safe column name df = df.merge(df_weather[['shipname','avg_precipitation_safe']], on='shipname', how='left')  # ----------------------------- # 6️⃣ Compute weather risk # ----------------------------- df['weather_risk_score'] = df['avg_precipitation_safe'] / df['avg_precipitation_safe'].max()  # ----------------------------- # 7️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # ----------------------------- # 8️⃣ Categorize risk # ----------------------------- def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 9️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully (precipitation-only, safe column)!") print("Saved to:", final_path)  # ----------------------------- # 10️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
# Convert to numeric, coerce errors to NaN df['avg_precipitation_safe'] = pd.to_numeric(df['avg_precipitation_safe'], errors='coerce')  # Optional: fill NaNs with 0 (or a small value) df['avg_precipitation_safe'] = df['avg_precipitation_safe'].fillna(0)
df['weather_risk_score'] = df['avg_precipitation_safe'] / df['avg_precipitation_safe'].max()
# Convert shipname to string df['shipname'] = df['shipname'].astype(str) df_weather['shipname'] = df_weather['shipname'].astype(str)  # Convert precipitation to numeric df_weather['avg_precipitation_safe'] = pd.to_numeric(df_weather['avg_precipitation_safe'], errors='coerce').fillna(0)  # Merge df = df.merge(df_weather[['shipname','avg_precipitation_safe']], on='shipname', how='left')  # Compute weather risk df['weather_risk_score'] = df['avg_precipitation_safe'] / df['avg_precipitation_safe'].max()
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset WITHOUT relying on ArcGIS header # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, header=None, encoding='utf-8-sig')  # ----------------------------- # 3️⃣ Assign safe column names immediately # ----------------------------- df_weather.columns = ['shipname', 'avg_speed_knots', 'avg_wind_speed', 'avg_precipitation_safe']  print("Safe weather columns:", df_weather.columns.tolist())  # ----------------------------- # 4️⃣ Convert shipname columns to string for merging # ----------------------------- df['shipname'] = df['shipname'].astype(str) df_weather['shipname'] = df_weather['shipname'].astype(str)  # ----------------------------- # 5️⃣ Convert precipitation column to numeric (forces any hidden non-numeric to NaN) # ----------------------------- df_weather['avg_precipitation_safe'] = pd.to_numeric(df_weather['avg_precipitation_safe'], errors='coerce').fillna(0)  # ----------------------------- # 6️⃣ Merge weather with Phase 4 dataset # ----------------------------- df = df.merge(df_weather[['shipname','avg_precipitation_safe']], on='shipname', how='left')  # ----------------------------- # 7️⃣ Compute weather risk score # ----------------------------- df['weather_risk_score'] = df['avg_precipitation_safe'] / df['avg_precipitation_safe'].max()  # ----------------------------- # 8️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # ----------------------------- # 9️⃣ Categorize operational risk # ----------------------------- def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 🔟 Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully!") print("Saved to:", final_path)  # ----------------------------- # 11️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load dataset # ----------------------------- file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df = pd.read_csv(file_path)  # ----------------------------- # 2️⃣ Normalize maintenance risk # ----------------------------- df['maintenance_risk_score_norm'] = df['maintenance_risk_score'] / df['maintenance_risk_score'].max()  # ----------------------------- # 3️⃣ Normalize traffic prediction (binary, already 0/1) # ----------------------------- df['predicted_high_traffic_norm'] = df['predicted_high_traffic']  # ----------------------------- # 4️⃣ Normalize weather risk (already 0–1) # ----------------------------- df['weather_risk_score_norm'] = df['weather_risk_score']  # already normalized  # ----------------------------- # 5️⃣ Recompute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic_norm'] +     0.3 * df['maintenance_risk_score_norm'] +     0.3 * df['weather_risk_score_norm'] )  # ----------------------------- # 6️⃣ Categorize operational risk # ----------------------------- def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 7️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Operational.csv" df.to_csv(final_path, index=False)  # ----------------------------- # 8️⃣ Quick validation # ----------------------------- print("✅ Final operational risk dataset ready!") print("Saved to:", final_path) print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts()) print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd  # ----------------------------- # 1️⃣ Load final operational dataset # ----------------------------- file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Operational.csv" df = pd.read_csv(file_path)  # ----------------------------- # 2️⃣ Compute percentile thresholds # ----------------------------- low_thresh = df['operational_risk_score_final'].quantile(0.5)  # median med_thresh = df['operational_risk_score_final'].quantile(0.8)  # 80th percentile  # ----------------------------- # 3️⃣ Assign balanced categories # ----------------------------- def categorize_risk_pct(score):     if score <= low_thresh:         return 'Low'     elif score <= med_thresh:         return 'Medium'     else:         return 'High'  df['operational_risk_category_pct'] = df['operational_risk_score_final'].apply(categorize_risk_pct)  # ----------------------------- # 4️⃣ Compute fleet risk rank # ----------------------------- df['fleet_risk_rank'] = df['operational_risk_score_final'].rank(method='dense', ascending=False).astype(int)  # ----------------------------- # 5️⃣ Save enhanced dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Operational_Enhanced.csv" df.to_csv(final_path, index=False)  # ----------------------------- # 6️⃣ Quick validation # ----------------------------- print("✅ Enhanced operational risk dataset ready!") print("Saved to:", final_path)  print("\nPercentile-based operational risk counts:") print(df['operational_risk_category_pct'].value_counts())  print("\nFleet risk rank stats:") print(df['fleet_risk_rank'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load final operational dataset # ----------------------------- file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Operational.csv" df = pd.read_csv(file_path)  # ----------------------------- # 2️⃣ Normalize maintenance risk (already 0–1, ensure) # ----------------------------- df['maintenance_risk_score_norm'] = df['maintenance_risk_score'] / df['maintenance_risk_score'].max()  # ----------------------------- # 3️⃣ Normalize traffic prediction (binary) # ----------------------------- df['predicted_high_traffic_norm'] = df['predicted_high_traffic']  # ----------------------------- # 4️⃣ Normalize weather risk (already 0–1) # ----------------------------- df['weather_risk_score_norm'] = df['weather_risk_score']  # ----------------------------- # 5️⃣ Recompute final operational risk score # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic_norm'] +     0.3 * df['maintenance_risk_score_norm'] +     0.3 * df['weather_risk_score_norm'] )  # ----------------------------- # 6️⃣ Compute percentile-based risk categories # ----------------------------- low_thresh = df['operational_risk_score_final'].quantile(0.5) med_thresh = df['operational_risk_score_final'].quantile(0.8)  def categorize_risk_pct(score):     if score <= low_thresh:         return 'Low'     elif score <= med_thresh:         return 'Medium'     else:         return 'High'  df['operational_risk_category_pct'] = df['operational_risk_score_final'].apply(categorize_risk_pct)  # ----------------------------- # 7️⃣ Compute fleet risk rank safely # ----------------------------- # Fill any NaNs with 0 (lowest priority) before ranking df['fleet_risk_rank'] = df['operational_risk_score_final'].fillna(0).rank(method='dense', ascending=False).astype(int)  # ----------------------------- # 8️⃣ Save enhanced dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Operational_Enhanced.csv" df.to_csv(final_path, index=False)  # ----------------------------- # 9️⃣ Quick validation # ----------------------------- print("✅ Enhanced operational risk dataset ready!") print("Saved to:", final_path) print("\nPercentile-based operational risk counts:") print(df['operational_risk_category_pct'].value_counts()) print("\nFleet risk rank stats:") print(df['fleet_risk_rank'].describe()) print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
