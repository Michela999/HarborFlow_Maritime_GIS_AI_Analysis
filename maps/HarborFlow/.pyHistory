import pandas as pd import arcpy  # Paths csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  # Load CSV df = pd.read_csv(csv_path)  # Ensure shipname is string, strip spaces, lowercase df['shipname_norm'] = df['shipname'].astype(str).str.strip().str.lower() df['predicted_high_traffic'] = df['high_traffic_flag']  # Save normalized CSV for join df[['shipname_norm','predicted_high_traffic']].to_csv(csv_path, index=False)  # Add JOIN_KEY in ArcGIS if missing if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.AddField(fc, "JOIN_KEY", "TEXT", field_length=100)  # Populate JOIN_KEY in ArcGIS: strip spaces + lowercase arcpy.management.CalculateField(fc, "JOIN_KEY", "!" + "shipname" + "!.strip().lower()", "PYTHON3")  # Perform join using normalized keys arcpy.management.JoinField(fc, "JOIN_KEY", csv_path, "shipname_norm", ["predicted_high_traffic"])  # Check distribution with arcpy.da.SearchCursor(fc, ["predicted_high_traffic"]) as cursor:     values = [row[0] for row in cursor]  high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100 print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
