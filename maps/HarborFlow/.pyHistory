import arcpy  # ----------------------------- # CONFIGURATION # ----------------------------- gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  features = gdb + r"\AIS_points" table = gdb + r"\ml_predictions" output_fc = gdb + r"\AIS_points_predicted" clean_field = "JOIN_KEY"  # ----------------------------- # STEP 1 – ADD CLEAN JOIN FIELD # ----------------------------- for dataset in [features, table]:     if clean_field not in [f.name for f in arcpy.ListFields(dataset)]:         arcpy.AddField_management(dataset, clean_field, "TEXT", field_length=100)  # ----------------------------- # STEP 2 – STANDARDIZE JOIN KEYS # ----------------------------- # Feature Class with arcpy.da.UpdateCursor(features, ["ShipName", clean_field]) as cursor:     for row in cursor:         row[1] = str(row[0]).strip().upper() if row[0] else None         cursor.updateRow(row)  # Table with arcpy.da.UpdateCursor(table, ["shipname", clean_field]) as cursor:     for row in cursor:         row[1] = str(row[0]).strip().upper() if row[0] else None         cursor.updateRow(row)  print("Join keys standardized.")  # ----------------------------- # STEP 3 – JOIN CSV TO FEATURES # ----------------------------- arcpy.management.AddJoin(features, clean_field, table, clean_field, "KEEP_COMMON") print("Join executed.")  # ----------------------------- # STEP 4 – EXPORT PREDICTED FEATURE CLASS # ----------------------------- arcpy.CopyFeatures_management(features, output_fc) print("Predicted feature class created:", output_fc)  # ----------------------------- # STEP 5 – VERIFY OUTPUT # ----------------------------- print("Output exists?", arcpy.Exists(output_fc)) print("Fields in output:") for f in arcpy.ListFields(output_fc):     print(f.name)
import arcpy import os  # ----------------------------- # CONFIGURATION # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  # Feature class fc = os.path.join(gdb, "AIS_points_predicted")  # Portfolio output folder output_folder = os.path.join(project_root, "docs", "screens", "phase4") if not os.path.exists(output_folder):     os.makedirs(output_folder) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  # ----------------------------- # STEP 1 – VERIFY JOINED FIELD # ----------------------------- predicted_field = None for f in arcpy.ListFields(fc):     if "predicted_high_traffic" in f.name.lower():         predicted_field = f.name         break  if predicted_field is None:     raise Exception("Predicted field not found. Check your join.")  print("Using predicted field:", predicted_field)  # ----------------------------- # STEP 2 – APPLY UNIQUE VALUE SYMBOLOGY # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT")  # assumes running inside ArcGIS Pro m = aprx.activeMap  # Add layer if not already in map layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break  if layer is None:     layer = m.addDataFromPath(fc)  # Apply unique value renderer sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = [predicted_field] layer.symbology = sym  # Set colors: 0 = green, 1 = red for c in layer.symbology.renderer.groups[0].classes:     if str(c.values[0]) == "0":         c.symbol.color = (0, 255, 0)     elif str(c.values[0]) == "1":         c.symbol.color = (255, 0, 0)  print("Symbology applied.")  # ----------------------------- # STEP 3 – EXPORT MAP LAYOUT AS PNG # ----------------------------- lyt = aprx.listLayouts()[0]  # assumes first layout in project lyt.exportToPNG(map_png, resolution=300) print("Map exported to PNG:", map_png)  # ----------------------------- # STEP 4 – FINAL MESSAGE # ----------------------------- print("✅ Phase 4 automation complete. Visualizations saved in:", output_folder)
import arcpy import os  gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" arcpy.env.workspace = gdb  fc = os.path.join(gdb, "AIS_points_predicted")  print("Fields in AIS_points_predicted:") for f in arcpy.ListFields(fc):     print(f.name)
import arcpy gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted" pred_table = gdb + r"\ml_predictions" join_field = "JOIN_KEY" pred_field_name = "predicted_high_traffic"  # Add field to feature class if not exists if pred_field_name not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.AddField_management(fc, pred_field_name, "SHORT")  # 0/1 field
# Make a dictionary from table pred_dict = {} with arcpy.da.SearchCursor(pred_table, [join_field, "predicted_high_traffic"]) as cursor:     for row in cursor:         key = str(row[0]).strip().upper()         pred_dict[key] = row[1]  # Update feature class with arcpy.da.UpdateCursor(fc, [join_field, pred_field_name]) as cursor:     for row in cursor:         key = str(row[0]).strip().upper()         if key in pred_dict:             row[1] = pred_dict[key]         else:             row[1] = None         cursor.updateRow(row)
print("Predicted field now exists and populated.") for f in arcpy.ListFields(fc):     print(f.name)
import arcpy import os  # ----------------------------- # CONFIGURATION # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  fc = os.path.join(gdb, "AIS_points_predicted")  # Portfolio output folder output_folder = os.path.join(project_root, "docs", "screens", "phase4") if not os.path.exists(output_folder):     os.makedirs(output_folder) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  # ----------------------------- # STEP 1 – APPLY UNIQUE VALUE SYMBOLOGY # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT")  # running inside ArcGIS Pro m = aprx.activeMap  # Add layer if not in map layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break if layer is None:     layer = m.addDataFromPath(fc)  # Unique value renderer on predicted_high_traffic sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"] layer.symbology = sym  # Set colors: 0 = green, 1 = red for c in layer.symbology.renderer.groups[0].classes:     if str(c.values[0]) == "0":         c.symbol.color = (0, 255, 0)     elif str(c.values[0]) == "1":         c.symbol.color = (255, 0, 0)  print("Symbology applied.")  # ----------------------------- # STEP 2 – EXPORT MAP LAYOUT AS PNG # ----------------------------- lyt = aprx.listLayouts()[0]  # assumes first layout in project lyt.exportToPNG(map_png, resolution=300)  print("✅ Phase 4 map exported to:", map_png)
import arcpy import os  project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  fc = os.path.join(gdb, "AIS_points_predicted")  # Portfolio output folder output_folder = os.path.join(project_root, "docs", "screens", "phase4") if not os.path.exists(output_folder):     os.makedirs(output_folder) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  # ----------------------------- # STEP 1 – ADD LAYER # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.activeMap  layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break if layer is None:     layer = m.addDataFromPath(fc)  # ----------------------------- # STEP 2 – UNIQUE VALUE SYMBOLOGY # ----------------------------- sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"]  # Set colors manually for values for val in sym.renderer.groups[0].items:  # Use items, not classes     if str(val.values[0]) == "0":         val.symbol.color = (0, 255, 0, 100)  # green with 100% opacity     elif str(val.values[0]) == "1":         val.symbol.color = (255, 0, 0, 100)  # red with 100% opacity  layer.symbology = sym print("Symbology applied successfully.")  # ----------------------------- # STEP 3 – EXPORT MAP LAYOUT AS PNG # ----------------------------- lyt = aprx.listLayouts()[0]  # assumes first layout lyt.exportToPNG(map_png, resolution=300) print("Map exported to PNG:", map_png)
import arcpy import os  project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  fc = os.path.join(gdb, "AIS_points_predicted")  # Portfolio output folder output_folder = os.path.join(project_root, "docs", "screens", "phase4") os.makedirs(output_folder, exist_ok=True) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  # ----------------------------- # STEP 1 – ADD LAYER # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.activeMap  layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break if layer is None:     layer = m.addDataFromPath(fc)  # ----------------------------- # STEP 2 – UNIQUE VALUE SYMBOLOGY # ----------------------------- sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"]  for val in sym.renderer.groups[0].items:     if str(val.values[0]) == "0":         val.symbol.color = (0, 255, 0, 100)  # green     elif str(val.values[0]) == "1":         val.symbol.color = (255, 0, 0, 100)  # red  layer.symbology = sym print("Symbology applied successfully.")  # ----------------------------- # STEP 3 – ZOOM TO LAYER EXTENT # ----------------------------- for mf in aprx.listMaps():     if layer in mf.listLayers():         mf.defaultView.camera.setExtent(layer.getExtent())  # ----------------------------- # STEP 4 – EXPORT MAP LAYOUT AS PNG # ----------------------------- lyt = aprx.listLayouts()[0]  # assumes first layout # make sure layout has a map frame map_frame = lyt.listElements("MAPFRAME_ELEMENT")[0]  # first map frame map_frame.camera.setExtent(layer.getExtent())  lyt.exportToPNG(map_png, resolution=300) print("Map exported to PNG:", map_png)
import arcpy import os  # ----------------------------- # CONFIGURATION # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  fc = os.path.join(gdb, "AIS_points_predicted")  # Portfolio output folder output_folder = os.path.join(project_root, "docs", "screens", "phase4") os.makedirs(output_folder, exist_ok=True) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  # ----------------------------- # STEP 1 – ADD LAYER # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.activeMap  layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break if layer is None:     layer = m.addDataFromPath(fc)  # ----------------------------- # STEP 2 – APPLY UNIQUE VALUE SYMBOLOGY # ----------------------------- sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"]  for val in sym.renderer.groups[0].items:     if str(val.values[0]) == "0":         val.symbol.color = (0, 255, 0, 100)  # green     elif str(val.values[0]) == "1":         val.symbol.color = (255, 0, 0, 100)  # red  layer.symbology = sym print("Symbology applied successfully.")  # ----------------------------- # STEP 3 – ZOOM MAP FRAME TO LAYER EXTENT # ----------------------------- desc = arcpy.Describe(fc) extent = desc.extent  # this is a real extent object  # Layout & MapFrame lyt = aprx.listLayouts()[0]  # assumes first layout map_frame = lyt.listElements("MAPFRAME_ELEMENT")[0]  # first map frame map_frame.camera.setExtent(extent)  # zoom to feature class extent  # ----------------------------- # STEP 4 – EXPORT MAP LAYOUT AS PNG # ----------------------------- lyt.exportToPNG(map_png, resolution=300) print("✅ Map exported to PNG:", map_png)
import arcpy import os  project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb  fc = os.path.join(gdb, "AIS_points_predicted") output_folder = os.path.join(project_root, "docs", "screens", "phase4") os.makedirs(output_folder, exist_ok=True) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.activeMap  # Add layer if not exists layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break if layer is None:     layer = m.addDataFromPath(fc)  # Symbology sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"] for val in sym.renderer.groups[0].items:     if str(val.values[0]) == "0":         val.symbol.color = (0, 255, 0, 100)     elif str(val.values[0]) == "1":         val.symbol.color = (255, 0, 0, 100) layer.symbology = sym  # Zoom to layer desc = arcpy.Describe(fc) m.defaultView.camera.setExtent(desc.extent)  # Export map view directly m.exportToPNG(map_png, 300) print("✅ Map exported directly from map view:", map_png)
# sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"]  for val in sym.renderer.groups[0].items:     val.symbol.applySymbolFromGallery('Circle 8 pt')  # solid circle     val.symbol.outlineColor = (0,0,0,0)  # remove black outline     if str(val.values[0]) == "0":         val.symbol.color = (0, 255, 0, 100)     elif str(val.values[0]) == "1":         val.symbol.color = (255, 0, 0, 100)  layer.symbology = sym aprx.activeView.refresh()
import arcpy from arcpy import mp import os  # ----------------------------- # CONFIG # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  fc = os.path.join(gdb, "AIS_points_predicted") output_folder = os.path.join(project_root, "docs", "screens", "phase4") os.makedirs(output_folder, exist_ok=True) map_png = os.path.join(output_folder, "AIS_HighTraffic_Map.png")  aprx = mp.ArcGISProject("CURRENT") m = aprx.activeMap  # ----------------------------- # Add layer # ----------------------------- layer = None for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         layer = lyr         break if layer is None:     layer = m.addDataFromPath(fc)  # ----------------------------- # Apply solid red/green symbology using CIM # ----------------------------- sym = layer.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"]  # Get CIM for symbols cim = sym.renderer  for val in cim.groups[0].items:     # Create new CIMPointSymbol for filled circle     from arcpy.cim import CIMPointSymbol, CIMSolidStroke, CIMSolidFill, CIMColor     fill_color = CIMColor({'RGB': [0, 255, 0, 100]}) if str(val.values[0])=="0" else CIMColor({'RGB': [255, 0, 0, 100]})     val.symbol = CIMPointSymbol()     val.symbol.symbolLayers[0].type = 'CIMSolidMarker'     val.symbol.symbolLayers[0].size = 8  # size in points     val.symbol.symbolLayers[0].fillColor = fill_color     val.symbol.symbolLayers[0].outlineColor = CIMColor({'RGB':[0,0,0,0]})  # remove outline  layer.symbology = sym  # ----------------------------- # Zoom layout map frame to layer extent # ----------------------------- desc = arcpy.Describe(fc) lyt = aprx.listLayouts()[0] map_frame = lyt.listElements("MAPFRAME_ELEMENT")[0] map_frame.camera.setExtent(desc.extent)  # ----------------------------- # Export layout as PNG # ----------------------------- lyt.exportToPNG(map_png, resolution=300) print("✅ Phase 4 map exported to:", map_png)
import arcpy import os  project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") arcpy.env.workspace = gdb arcpy.env.overwriteOutput = True  fc = os.path.join(gdb, "AIS_points")  # original points in GDB table = os.path.join(gdb, "ml_predictions") out_fc = os.path.join(gdb, "AIS_points_predicted")  # Remove old output if exists if arcpy.Exists(out_fc):     arcpy.Delete_management(out_fc)  # Make a permanent join arcpy.management.JoinField(in_data=fc,                            in_field="JOIN_KEY",  # make sure keys are standardized                            join_table=table,                            join_field="JOIN_KEY",                            fields=["predicted_high_traffic"])  # Copy to new feature class arcpy.management.CopyFeatures(fc, out_fc) print("✅ Permanent predicted_high_traffic field added to:", out_fc)
