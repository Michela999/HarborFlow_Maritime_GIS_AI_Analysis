 # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False, encoding='utf-8-sig')  print("✅ Weather integrated successfully!") print("Saved final multi-factor dataset to:", final_path)  # ----------------------------- # 8️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
