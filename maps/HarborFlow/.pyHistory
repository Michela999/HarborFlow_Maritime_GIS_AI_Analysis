import pandas as pd import arcpy  # ----------------------------- # 1️⃣ Load and clean CSV # ----------------------------- csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv"  df = pd.read_csv(csv_path)  # Remove NULLs or empty keys df = df[df['shipname_norm'].notna() & (df['shipname_norm'].str.strip() != '')]  # Ensure predicted_high_traffic exists if 'predicted_high_traffic' not in df.columns:     df['predicted_high_traffic'] = 0  # Save cleaned CSV df.to_csv(csv_path, index=False) print(f"✅ CSV cleaned: {len(df)} rows ready for ArcGIS join")  # ----------------------------- # 2️⃣ Update ArcGIS feature class # ----------------------------- gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  # Add JOIN_KEY if missing if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.AddField(fc, "JOIN_KEY", "TEXT", field_length=100)  # Populate JOIN_KEY safely (normalize and replace NULLs) with arcpy.da.UpdateCursor(fc, ["shipname", "JOIN_KEY"]) as cursor:     for row in cursor:         ship = row[0]         if ship is None or str(ship).strip() == '':             row[1] = ''  # replace NULLs         else:             row[1] = str(ship).strip().lower()         cursor.updateRow(row)  print("✅ ArcGIS JOIN_KEY populated and cleaned")  # ----------------------------- # 3️⃣ Join CSV to ArcGIS # ----------------------------- arcpy.management.JoinField(fc, "JOIN_KEY", csv_path, "shipname_norm", ["predicted_high_traffic"]) print("✅ ArcGIS feature class joined with CSV")  # ----------------------------- # 4️⃣ Compute High/Low Traffic Distribution # ----------------------------- with arcpy.da.SearchCursor(fc, ["predicted_high_traffic"]) as cursor:     values = [row[0] for row in cursor]  high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100 print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
import pandas as pd  csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv"  # Load CSV df = pd.read_csv(csv_path)  # Convert shipname_norm to string, replace NaN with empty string, strip spaces, lowercase df['shipname_norm'] = df['shipname_norm'].fillna('').astype(str).str.strip().str.lower()  # Remove rows that are empty after stripping df = df[df['shipname_norm'] != '']  # Ensure predicted_high_traffic exists if 'predicted_high_traffic' not in df.columns:     df['predicted_high_traffic'] = 0  # Save cleaned CSV df.to_csv(csv_path, index=False) print(f"✅ CSV cleaned: {len(df)} rows ready for ArcGIS join")
