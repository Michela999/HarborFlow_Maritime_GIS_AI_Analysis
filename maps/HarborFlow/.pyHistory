import arcpy import os  # ----------------------------- # Paths # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") fc_predicted = os.path.join(gdb, "AIS_points_predicted") lyrx_path = os.path.join(project_root, "data", "processed", "AIS_points_predicted.lyrx")  # ----------------------------- # Create Map and Layer object # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps()[0]  # Remove existing layer if already in map for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         m.removeLayer(lyr)  # Add the predicted points lyr = m.addDataFromPath(fc_predicted)  # ----------------------------- # Apply Unique Value Symbology # ----------------------------- # Field: predicted_high_traffic sym = lyr.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ['predicted_high_traffic']  # Define colors: 0 = green, 1 = red # CIMColor RGB cim_green = {'RGB': [0, 176, 80, 100]}  # solid green cim_red = {'RGB': [255, 0, 0, 100]}     # solid red  # Clear existing groups/items sym.renderer.groups[0].items.clear()  # Create items for 0 and 1 item0 = sym.renderer.createItem('0') item0.symbol.color = cim_green item0.symbol.size = 6  # marker size item1 = sym.renderer.createItem('1') item1.symbol.color = cim_red item1.symbol.size = 6  # Add items to renderer sym.renderer.groups[0].items.append(item0) sym.renderer.groups[0].items.append(item1)  # Apply symbology to layer lyr.symbology = sym  # ----------------------------- # Save as Layer File # ----------------------------- lyr.saveACopy(lyrx_path) print(f"✅ Pre-symbolized layer saved: {lyrx_path}")
import arcpy import os  # ----------------------------- # Paths # ----------------------------- project_root = r"C:\Users\miche\Documents\HarborFlow_Fresh" gdb = os.path.join(project_root, "data", "processed", "HarborFlow.gdb") fc_predicted = os.path.join(gdb, "AIS_points_predicted") lyrx_path = os.path.join(project_root, "data", "processed", "AIS_points_predicted.lyrx")  # ----------------------------- # Add layer to map # ----------------------------- aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps()[0]  # Remove existing layer if exists for lyr in m.listLayers():     if lyr.name == "AIS_points_predicted":         m.removeLayer(lyr)  lyr = m.addDataFromPath(fc_predicted)  # ----------------------------- # Apply Unique Value Symbology # ----------------------------- sym = lyr.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ['predicted_high_traffic']  # Clear existing items sym.renderer.groups[0].items.clear()  # Add values manually # ArcGIS Pro 3.x: create items using CIM for val, rgb in zip(['0', '1'], [[0, 176, 80, 100], [255, 0, 0, 100]]):     # Add the value to renderer     sym.renderer.addValues([val])     # Access the item and set symbol color     item = sym.renderer.groups[0].items[-1]     item.symbol.color = {'RGB': rgb}     item.symbol.size = 6  # marker size  # Apply symbology lyr.symbology = sym  # ----------------------------- # Save as layer file # ----------------------------- lyr.saveACopy(lyrx_path) print(f"✅ Pre-symbolized layer saved: {lyrx_path}")
import pandas as pd csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_predictions.csv" df = pd.read_csv(csv_path)  # Convert predicted_high_traffic to string df['predicted_high_traffic'] = df['predicted_high_traffic'].astype(str)  # Save CSV df.to_csv(csv_path, index=False) print("✅ predicted_high_traffic converted to text")
