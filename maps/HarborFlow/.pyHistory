aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps()[0]  # your main map lyr = m.listLayers("AIS_points_predicted_sym")[0]  # Make sure layer has unique value renderer sym = lyr.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"]  # Assign colors and labels sym.renderer.addAllValues()  # ensures all unique values are included  # Map 0 → Green / "Low Traffic" for v in sym.renderer.groups[0].values:     if v.value == 0:         v.color = {'RGB': [0, 255, 0, 100]}  # green         v.label = "Low Traffic"     elif v.value == 1:         v.color = {'RGB': [255, 0, 0, 100]}  # red         v.label = "High Traffic"  lyr.symbology = sym print("✅ Symbology with custom legend labels applied")
import arcpy  aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps()[0]  lyr = m.listLayers("AIS_points_predicted")[0]  # Unique Value Renderer sym = lyr.symbology sym.updateRenderer('UniqueValueRenderer') sym.renderer.fields = ["predicted_high_traffic"] sym.renderer.addAllValues()  # Adds all unique values in the field  # Assign colors and labels only for 0 and 1 for v in sym.renderer.groups[0].values:     if v.value == 0:         v.color = {'RGB': [0, 255, 0, 100]}  # Green         v.label = "Low Traffic"     elif v.value == 1:         v.color = {'RGB': [255, 0, 0, 100]}  # Red         v.label = "High Traffic"  lyr.symbology = sym print("✅ Symbology applied: Low = green, High = red")
