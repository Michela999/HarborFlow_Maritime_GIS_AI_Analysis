import pandas as pd import arcpy  # Paths gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  weather_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_data.csv" maintenance_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\maintenance_data.csv" output_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau.csv"  # ----------------------------- # 1️⃣ Convert ArcGIS feature class to DataFrame # ----------------------------- fields = ["ShipName", "predicted_high_traffic_1"] rows = [row for row in arcpy.da.SearchCursor(fc, fields)] df_ais = pd.DataFrame(rows, columns=fields)  # ----------------------------- # 2️⃣ Load weather and maintenance CSVs # ----------------------------- df_weather = pd.read_csv(weather_csv) df_maintenance = pd.read_csv(maintenance_csv)  # ----------------------------- # 3️⃣ Merge datasets # ----------------------------- df_merge = df_ais.merge(df_weather, on="ShipName", how="left") df_merge = df_merge.merge(df_maintenance, on="ShipName", how="left")  # ----------------------------- # 4️⃣ Save Tableau-ready CSV # ----------------------------- df_merge.to_csv(output_csv, index=False) print(f"✅ Tableau-ready CSV created: {output_csv}") print(df_merge.head())
import pandas as pd  # Latest export file paths traffic_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ais_traffic_export.csv" speed_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ais_avg_speed_export.csv" weather_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" maintenance_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\maintenance_gaps_export.csv" output_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau.csv"  # Load latest exports df_traffic = pd.read_csv(traffic_csv) df_speed = pd.read_csv(speed_csv) df_weather = pd.read_csv(weather_csv) df_maintenance = pd.read_csv(maintenance_csv)  # Normalize ship names/IDs for df in [df_traffic, df_speed, df_weather, df_maintenance]:     df['ShipName'] = df['ShipName'].astype(str).str.strip()  # Merge all datasets sequentially df_merge = df_traffic.merge(df_speed, on='ShipName', how='left') df_merge = df_merge.merge(df_weather, on='ShipName', how='left') df_merge = df_merge.merge(df_maintenance, on='ShipName', how='left')  # Save final Tableau-ready CSV df_merge.to_csv(output_csv, index=False) print(f"✅ Tableau-ready CSV created with traffic, speed, weather, and maintenance: {output_csv}") print(df_merge.head())
