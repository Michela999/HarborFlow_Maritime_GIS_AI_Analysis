fc = os.path.join(gdb, "AIS_points") table = os.path.join(gdb, "ml_predictions")  # Remove old predicted field if needed if "predicted_high_traffic" in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.DeleteField(fc, "predicted_high_traffic")  # Join using TEXT fields arcpy.management.JoinField(     fc,     "ShipName_txt",     table,     "JOIN_KEY_TXT",     ["predicted_high_traffic"] )  print("✅ Clean text-based join completed")
import arcpy aprx = arcpy.mp.ArcGISProject("CURRENT") lyt = aprx.listLayouts("Phase4_Layout")[0] map_frame = lyt.listElements("MAPFRAME_ELEMENT")[0]  desc = arcpy.Describe(r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb\AIS_points_predicted") x_buffer = (desc.extent.XMax - desc.extent.XMin) * 0.1 y_buffer = (desc.extent.YMax - desc.extent.YMin) * 0.1 buffered_extent = arcpy.Extent(     desc.extent.XMin - x_buffer,     desc.extent.YMin - y_buffer,     desc.extent.XMax + x_buffer,     desc.extent.YMax + y_buffer ) map_frame.camera.setExtent(buffered_extent)
