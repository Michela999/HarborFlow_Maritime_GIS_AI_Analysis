import pandas as pd import arcpy  # Load CSV keys csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" df = pd.read_csv(csv_path) csv_keys = set(df['shipname_norm']) print("CSV sample keys:", list(csv_keys)[:10])  # Load ArcGIS JOIN_KEY values gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted" arc_keys = set() with arcpy.da.SearchCursor(fc, ["JOIN_KEY"]) as cursor:     for row in cursor:         arc_keys.add(row[0].strip().lower() if row[0] else '') print("ArcGIS sample keys:", list(arc_keys)[:10])  # Check intersection matched_keys = csv_keys.intersection(arc_keys) print("Matched keys:", len(matched_keys)) print("Unmatched CSV keys:", len(csv_keys - matched_keys))
import pandas as pd import arcpy  # ----------------------------- # 1️⃣ Clean CSV keys # ----------------------------- csv_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_features_dataset.csv" df = pd.read_csv(csv_path)  # Convert to int then str to remove .0 if any df['shipname_norm'] = df['shipname_norm'].astype(int).astype(str)  # Ensure predicted_high_traffic exists if 'predicted_high_traffic' not in df.columns:     df['predicted_high_traffic'] = 0  df.to_csv(csv_path, index=False) print("✅ CSV keys normalized to strings")  # ----------------------------- # 2️⃣ Clean ArcGIS JOIN_KEY # ----------------------------- gdb = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb" fc = gdb + r"\AIS_points_predicted"  # Add JOIN_KEY if missing if "JOIN_KEY" not in [f.name for f in arcpy.ListFields(fc)]:     arcpy.management.AddField(fc, "JOIN_KEY", "TEXT", field_length=100)  # Populate JOIN_KEY as string integer with arcpy.da.UpdateCursor(fc, ["shipname", "JOIN_KEY"]) as cursor:     for row in cursor:         ship = row[0]         if ship is None:             row[1] = ''         else:             row[1] = str(int(float(ship)))  # remove decimal         cursor.updateRow(row)  print("✅ ArcGIS JOIN_KEY normalized to string integers")  # ----------------------------- # 3️⃣ Perform join # ----------------------------- arcpy.management.JoinField(fc, "JOIN_KEY", csv_path, "shipname_norm", ["predicted_high_traffic"]) print("✅ ArcGIS feature class joined with CSV")  # ----------------------------- # 4️⃣ Compute High/Low Traffic Distribution # ----------------------------- with arcpy.da.SearchCursor(fc, ["predicted_high_traffic"]) as cursor:     values = [row[0] for row in cursor]  high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100 print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
import arcpy  fc = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\HarborFlow.gdb\AIS_points_predicted"  # Make sure we use the correct field field_name = "predicted_high_traffic"  # Read values with arcpy.da.SearchCursor(fc, [field_name]) as cursor:     values = [row[0] for row in cursor]  # Compute percentages high_pct = values.count(1)/len(values)*100 low_pct = values.count(0)/len(values)*100  print(f"High traffic: {high_pct:.2f}% | Low traffic: {low_pct:.2f}%")
