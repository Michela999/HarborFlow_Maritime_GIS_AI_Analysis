import pandas as pd  # Latest exports traffic_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ais_traffic_export.csv" speed_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ais_avg_speed_export.csv" weather_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" maintenance_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\maintenance_gaps_export.csv" output_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau.csv"  # Load datasets df_traffic = pd.read_csv(traffic_csv) df_speed = pd.read_csv(speed_csv) df_weather = pd.read_csv(weather_csv) df_maintenance = pd.read_csv(maintenance_csv)  # Rename vessel_id to shipname in maintenance df_maintenance.rename(columns={'vessel_id':'shipname'}, inplace=True)  # Optional: remove duplicate speed column from weather to avoid conflict df_weather = df_weather.drop(columns=['avg_speed_knots'])  # Normalize shipname strings for df in [df_traffic, df_speed, df_weather, df_maintenance]:     df['shipname'] = df['shipname'].astype(str).str.strip()  # Merge sequentially on shipname df_merge = df_traffic.merge(df_speed, on='shipname', how='left') df_merge = df_merge.merge(df_weather, on='shipname', how='left') df_merge = df_merge.merge(df_maintenance, on='shipname', how='left')  # Save final Tableau-ready CSV df_merge.to_csv(output_csv, index=False) print(f"✅ Tableau-ready CSV created: {output_csv}") print(df_merge.head())
import pandas as pd  # Paths tableau_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau.csv" predictions_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_predictions.csv" output_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final.csv"  # Load df_tableau = pd.read_csv(tableau_csv) df_pred = pd.read_csv(predictions_csv)  # Inspect prediction columns print("Prediction columns:", df_pred.columns.tolist())  # Normalize key df_tableau['shipname'] = df_tableau['shipname'].astype(str).str.strip() df_pred['shipname'] = df_pred['shipname'].astype(str).str.strip()  # Merge predicted_high_traffic_1 df_final = df_tableau.merge(     df_pred[['shipname', 'predicted_high_traffic_1']],     on='shipname',     how='left' )  # Save final dataset df_final.to_csv(output_csv, index=False)  print("✅ Final Tableau dataset created!") print(df_final.head())
import pandas as pd  # Paths tableau_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau.csv" predictions_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\ml_predictions.csv" output_csv = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final.csv"  # Load df_tableau = pd.read_csv(tableau_csv) df_pred = pd.read_csv(predictions_csv)  # Normalize key df_tableau['shipname'] = df_tableau['shipname'].astype(str).str.strip() df_pred['shipname'] = df_pred['shipname'].astype(str).str.strip()  # Merge using correct column name df_final = df_tableau.merge(     df_pred[['shipname', 'predicted_high_traffic']],     on='shipname',     how='left' )  # Save df_final.to_csv(output_csv, index=False)  print("✅ Final Tableau dataset created successfully!") print(df_final.head())
import pandas as pd import numpy as np from datetime import datetime, timedelta  # Load final dataset df = pd.read_csv("data/processed/AIS_Tableau_Final.csv")  # Remove duplicates df = df.drop_duplicates(subset=['shipname']).copy()  today = datetime.today()  # Normalize speed for scaling if 'avg_speed_knots' in df.columns:     df['speed_factor'] = df['avg_speed_knots'] / df['avg_speed_knots'].max() else:     df['speed_factor'] = 0.5  # Base maintenance cycle BASE_CYCLE = 180  # 6 months  def compute_cycle(row):     cycle = BASE_CYCLE          # High traffic reduces cycle     if row['predicted_high_traffic'] == 1:         cycle -= 40              # High speed reduces cycle     cycle -= int(30 * row['speed_factor'])          return max(cycle, 90)  # never less than 3 months  df['maintenance_cycle_days'] = df.apply(compute_cycle, axis=1)  # Simulate last maintenance date df['last_maintenance'] = df['maintenance_cycle_days'].apply(     lambda x: today - timedelta(days=np.random.randint(0, x)) )  df['days_since_last_maintenance'] = (     today - pd.to_datetime(df['last_maintenance']) ).dt.days  df['maintenance_gap_days'] = (     df['days_since_last_maintenance'] - df['maintenance_cycle_days'] )  df['maintenance_risk_flag'] = (     df['maintenance_gap_days'] > 0 ).astype(int)  # Continuous degradation score df['maintenance_risk_score'] = (     df['days_since_last_maintenance'] /     df['maintenance_cycle_days'] )  # Save updated dataset df.to_csv("data/processed/AIS_Tableau_Final.csv", index=False)
import pandas as pd  file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final.csv"  df = pd.read_csv(file_path)  print(df.head())
import pandas as pd import numpy as np from datetime import datetime, timedelta  file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final.csv"  df = pd.read_csv(file_path)  # Remove duplicate vessels df = df.drop_duplicates(subset=['shipname']).copy()  today = datetime.today()  # Safety: ensure predicted_high_traffic exists if 'predicted_high_traffic' not in df.columns:     raise ValueError("predicted_high_traffic column missing.")  # Normalize speed safely if 'avg_speed_knots' in df.columns and df['avg_speed_knots'].notna().any():     df['speed_factor'] = df['avg_speed_knots'] / df['avg_speed_knots'].max() else:     df['speed_factor'] = 0.5  BASE_CYCLE = 180  # 6 months  def compute_cycle(row):     cycle = BASE_CYCLE          # Traffic impact     if row['predicted_high_traffic'] == 1:         cycle -= 40          # Speed impact     cycle -= int(30 * row['speed_factor'])          return max(cycle, 90)  # never below 90 days  df['maintenance_cycle_days'] = df.apply(compute_cycle, axis=1)  # Simulate last maintenance date df['last_maintenance'] = df['maintenance_cycle_days'].apply(     lambda x: today - timedelta(days=np.random.randint(0, x)) )  df['days_since_last_maintenance'] = (     today - pd.to_datetime(df['last_maintenance']) ).dt.days  df['maintenance_gap_days'] = (     df['days_since_last_maintenance'] - df['maintenance_cycle_days'] )  df['maintenance_risk_flag'] = (     df['maintenance_gap_days'] > 0 ).astype(int)  df['maintenance_risk_score'] = (     df['days_since_last_maintenance'] /     df['maintenance_cycle_days'] )  # Save updated dataset df.to_csv(file_path, index=False)  print("Maintenance model successfully applied.")
import pandas as pd import numpy as np from datetime import datetime, timedelta  # ----------------------------- # 1️⃣ Load the dataset # ----------------------------- file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final.csv" df = pd.read_csv(file_path)  # Remove duplicate vessels df = df.drop_duplicates(subset=['shipname']).copy()  today = datetime.today()  # ----------------------------- # 2️⃣ Ensure required columns # ----------------------------- if 'predicted_high_traffic' not in df.columns:     raise ValueError("predicted_high_traffic column missing in dataset.")  # Normalize speed for cycle adjustment if 'avg_speed_knots' in df.columns and df['avg_speed_knots'].notna().any():     df['speed_factor'] = df['avg_speed_knots'] / df['avg_speed_knots'].max() else:     df['speed_factor'] = 0.5  # default if missing  # ----------------------------- # 3️⃣ Compute maintenance cycles # ----------------------------- BASE_CYCLE = 180  # standard 6 months  def compute_cycle(row):     cycle = BASE_CYCLE     # Reduce cycle for high traffic vessels     if row['predicted_high_traffic'] == 1:         cycle -= 40     # Reduce cycle for high speed vessels     cycle -= int(30 * row['speed_factor'])     # Ensure minimum 90 days     return max(cycle, 90)  df['maintenance_cycle_days'] = df.apply(compute_cycle, axis=1)  # ----------------------------- # 4️⃣ Simulate last maintenance date # ----------------------------- df['last_maintenance'] = df['maintenance_cycle_days'].apply(     lambda x: today - timedelta(days=np.random.randint(0, x)) )  df['days_since_last_maintenance'] = (today - pd.to_datetime(df['last_maintenance'])).dt.days df['maintenance_gap_days'] = df['days_since_last_maintenance'] - df['maintenance_cycle_days'] df['maintenance_risk_flag'] = (df['maintenance_gap_days'] > 0).astype(int) df['maintenance_risk_score'] = df['days_since_last_maintenance'] / df['maintenance_cycle_days']  # ----------------------------- # 5️⃣ Save updated dataset # ----------------------------- new_file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v2.csv" df.to_csv(new_file_path, index=False)  print("Maintenance simulation applied successfully.") print("Saved updated dataset to:", new_file_path)  # ----------------------------- # 6️⃣ Quick summary checks # ----------------------------- print("\nMaintenance risk flag distribution:") print(df['maintenance_risk_flag'].value_counts(normalize=True))  print("\nMaintenance risk score stats:") print(df['maintenance_risk_score'].describe())
df['maintenance_risk_flag'] = (df['maintenance_risk_score'] > 1.0).astype(int)
# Weight traffic and maintenance (example: 50% each) df['operational_risk_score'] = (     0.5 * df['predicted_high_traffic'] + 0.5 * df['maintenance_risk_score'] )
import pandas as pd import numpy as np from datetime import datetime, timedelta  # ----------------------------- # 1️⃣ Load v2 dataset # ----------------------------- file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v2.csv" df = pd.read_csv(file_path)  # Remove duplicate vessels just in case df = df.drop_duplicates(subset=['shipname']).copy()  today = datetime.today()  # ----------------------------- # 2️⃣ Ensure required columns # ----------------------------- if 'predicted_high_traffic' not in df.columns:     raise ValueError("predicted_high_traffic column missing in dataset.")  if 'maintenance_risk_score' not in df.columns:     raise ValueError("maintenance_risk_score missing — run v2 maintenance simulation first.")  # ----------------------------- # 3️⃣ Correct maintenance risk flag # ----------------------------- # Flag only vessels overdue df['maintenance_risk_flag'] = (df['maintenance_risk_score'] > 1.0).astype(int)  # ----------------------------- # 4️⃣ Compute combined operational risk # ----------------------------- # Example: 50% traffic, 50% maintenance df['operational_risk_score'] = (     0.5 * df['predicted_high_traffic'] + 0.5 * df['maintenance_risk_score'] )  # Optional: categorize risk def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category'] = df['operational_risk_score'].apply(categorize_risk)  # ----------------------------- # 5️⃣ Save v3 dataset # ----------------------------- new_file_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df.to_csv(new_file_path, index=False)  print("✅ Phase 4 v3 dataset created successfully!") print("Saved to:", new_file_path)  # ----------------------------- # 6️⃣ Quick validation # ----------------------------- print("\nMaintenance risk flag distribution:") print(df['maintenance_risk_flag'].value_counts(normalize=True))  print("\nOperational risk category counts:") print(df['operational_risk_category'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path)  # ----------------------------- # 3️⃣ Merge weather data by vessel name # ----------------------------- df = df.merge(df_weather, on='shipname', how='left')  # ----------------------------- # 4️⃣ Normalize weather features # ----------------------------- # Assuming weather columns: wind_speed_knots, wave_height_m, storm_flag # Adjust column names if needed df['wind_norm'] = df['wind_speed_knots'] / df['wind_speed_knots'].max() df['wave_norm'] = df['wave_height_m'] / df['wave_height_m'].max() df['storm_norm'] = df.get('storm_flag', pd.Series(0, index=df.index))  # default 0 if missing  # ----------------------------- # 5️⃣ Compute weather risk score # ----------------------------- df['weather_risk_score'] = (     0.4 * df['wind_norm'] +     0.4 * df['wave_norm'] +     0.2 * df['storm_norm'] )  # ----------------------------- # 6️⃣ Compute final operational risk score # ----------------------------- # Weighted combination: Traffic 40%, Maintenance 30%, Weather 30% df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # Categorize risk def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 7️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully!") print("Saved final multi-factor dataset to:", final_path)  # ----------------------------- # 8️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd  weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path)  # List all columns print("Columns in weather CSV:") print(df_weather.columns.tolist())  # Show first few rows print("\nSample data:") print(df_weather.head())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path)  # ----------------------------- # 3️⃣ Merge weather data by vessel # ----------------------------- df = df.merge(df_weather[['shipname', 'avg_wind_speed', 'avg_precipitation']],                on='shipname', how='left')  # ----------------------------- # 4️⃣ Normalize weather features # ----------------------------- df['wind_norm'] = df['avg_wind_speed'] / df['avg_wind_speed'].max() df['precip_norm'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # Compute weather risk score (50% wind, 50% precipitation) df['weather_risk_score'] = 0.5 * df['wind_norm'] + 0.5 * df['precip_norm']  # ----------------------------- # 5️⃣ Compute final operational risk # ----------------------------- # Traffic: 40%, Maintenance: 30%, Weather: 30% df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  # Categorize final operational risk def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 6️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully!") print("Saved final multi-factor dataset to:", final_path)  # ----------------------------- # 7️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
