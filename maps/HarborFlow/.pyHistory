import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset (remove BOM) # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, encoding='utf-8-sig')  # ----------------------------- # 3️⃣ Clean column names # ----------------------------- # Remove invisible characters / BOM / extra whitespace df_weather.columns = df_weather.columns.str.replace(r'[\u200b\ufeff]', '', regex=True).str.strip() df.columns = df.columns.str.replace(r'[\u200b\ufeff]', '', regex=True).str.strip()  print("Cleaned weather columns:", df_weather.columns.tolist())  # ----------------------------- # 4️⃣ Merge by shipname # ----------------------------- df = df.merge(df_weather, on='shipname', how='left')  # ----------------------------- # 5️⃣ Normalize weather features safely # ----------------------------- weather_cols = {c.lower(): c for c in df_weather.columns}  wind_col = weather_cols.get('avg_wind_speed') precip_col = weather_cols.get('avg_precipitation')  if not wind_col or not precip_col:     raise ValueError("Weather CSV missing required columns!")  df['wind_norm'] = df[wind_col] / df[wind_col].max() df['precip_norm'] = df[precip_col] / df[precip_col].max() df['weather_risk_score'] = 0.5 * df['wind_norm'] + 0.5 * df['precip_norm']  # ----------------------------- # 6️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 7️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully!") print("Saved final multi-factor dataset to:", final_path)  # ----------------------------- # 8️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
import pandas as pd import numpy as np  # ----------------------------- # 1️⃣ Load Phase 4 v3 dataset # ----------------------------- v3_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_v3.csv" df = pd.read_csv(v3_path)  # ----------------------------- # 2️⃣ Load weather dataset (use precipitation only) # ----------------------------- weather_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\weather_speed_export.csv" df_weather = pd.read_csv(weather_path, encoding='utf-8-sig')  # Strip columns df_weather.columns = df_weather.columns.str.strip() df.columns = df.columns.str.strip()  print("Cleaned weather columns:", df_weather.columns.tolist())  # ----------------------------- # 3️⃣ Merge by shipname # ----------------------------- df = df.merge(df_weather[['shipname','avg_precipitation']], on='shipname', how='left')  # ----------------------------- # 4️⃣ Use avg_precipitation as weather risk # ----------------------------- df['weather_risk_score'] = df['avg_precipitation'] / df['avg_precipitation'].max()  # ----------------------------- # 5️⃣ Compute final operational risk # ----------------------------- df['operational_risk_score_final'] = (     0.4 * df['predicted_high_traffic'] +     0.3 * df['maintenance_risk_score'] +     0.3 * df['weather_risk_score'] )  def categorize_risk(score):     if score < 0.4:         return 'Low'     elif score < 0.7:         return 'Medium'     else:         return 'High'  df['operational_risk_category_final'] = df['operational_risk_score_final'].apply(categorize_risk)  # ----------------------------- # 6️⃣ Save final dataset # ----------------------------- final_path = r"C:\Users\miche\Documents\HarborFlow_Fresh\data\processed\AIS_Tableau_Final_Weather.csv" df.to_csv(final_path, index=False)  print("✅ Weather integrated successfully (precipitation-only)!") print("Saved to:", final_path)  # ----------------------------- # 7️⃣ Quick validation # ----------------------------- print("\nOperational risk category counts:") print(df['operational_risk_category_final'].value_counts())  print("\nOperational risk score stats:") print(df['operational_risk_score_final'].describe())
